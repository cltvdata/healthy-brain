rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function incomingData() {
      return request.resource.data;
    }

    // USER PROFILES: Users can only read/write their own document
    match /users/{userId} {
      allow read: if isAuthenticated(); // Allow reading other users for Matchmaking
      allow create: if isOwner(userId);
      
      // Prevent users from artificially inflating NTK balances maliciously
      allow update: if isOwner(userId) 
        && (!incomingData().keys().hasAny(['ntkBalance']) 
            || incomingData().ntkBalance <= resource.data.ntkBalance + 50); // Allow reasonable earnings only (+50 max)
            
      // Subcollections under users (e.g., metrics, sessions, etc)
      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // SQUADS: Any authenticated user can read. Only members can update.
    match /squads/{squadId} {
      allow read: if isAuthenticated();
      // Allow updates if the user's ID is in the members array of the squad
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.members);
      allow create: if isAuthenticated();
      allow delete: if false; // Only admins can delete squads
    }

    // TOURNAMENTS
    match /tournaments/{tourneyId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      allow create, delete: if false; 
    }

    // ECONOMY STATS
    match /economy/{docId} {
      allow read: if isAuthenticated();
      allow update: if false; // Global economy stats should be updated by backend/admin only
      allow create, delete: if false;
    }

    // SINERGIAS (Live Feed & Social Mining)
    match /sinergias/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Allow updating 'glows' count and 'glowedBy' array securely
      allow update: if isAuthenticated() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['glows', 'glowedBy'])
        && request.resource.data.glows == resource.data.glows + 1
        && !(request.auth.uid in resource.data.glowedBy)
        && (request.auth.uid in request.resource.data.glowedBy)
        && request.auth.uid != resource.data.userId // Prevent self-glow
      );
    }

    // SECURE DEFAULT: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

